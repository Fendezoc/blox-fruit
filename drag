-- Bomb Hub: draggable floating logo toggle
-- Upload the Bomb logo to Roblox and replace the placeholder image ID below.
pcall(function()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local player = Players.LocalPlayer

    local oldGui = CoreGui:FindFirstChild("BombHubFloatingLogo")
    if oldGui then oldGui:Destroy() end

    local logoGui = Instance.new("ScreenGui")
    logoGui.Name = "BombHubFloatingLogo"
    logoGui.ResetOnSpawn = false
    logoGui.IgnoreGuiInset = true
    logoGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    logoGui.Parent = CoreGui

    local logo = Instance.new("ImageButton")
    logo.Name = "BombLogoButton"
    logo.Size = UDim2.fromOffset(60, 60)
    logo.Position = UDim2.new(0, 20, 0.4, 0)
    logo.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    logo.BackgroundTransparency = 0.12
    logo.BorderSizePixel = 0
    logo.Image = "rbxassetid://YOUR_BOMB_IMAGE_ID"
    logo.ScaleType = Enum.ScaleType.Fit
    logo.AutoButtonColor = true
    logo.ZIndex = 1000
    logo.Parent = logoGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = logo
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 35, 55)
    stroke.Thickness = 2
    stroke.Parent = logo

    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPosition = nil
    local moved = false

    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPosition = logo.Position
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then moved = true end
            logo.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved then
                local root = Fluent.Window and Fluent.Window.Root
                if root and root:IsA("GuiObject") then
                    root.Visible = not root.Visible
                end
            end
            dragging = false
            dragInput = nil
        end
    end)
end)
